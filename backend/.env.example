# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI Provider (openai | anthropic | google | mock)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SECRET_KEY=change-me-in-production

# Duplicate detection thresholds (can override DB config)
DUPLICATE_SEARCH_RADIUS_M=500
DUPLICATE_TIME_WINDOW_HOURS=72
DUPLICATE_MERGE_THRESHOLD=0.75
DUPLICATE_REVIEW_THRESHOLD=0.50
AI_RELEVANCE_THRESHOLD=0.50

# Demo
DEMO_PASSWORD=demo1234
